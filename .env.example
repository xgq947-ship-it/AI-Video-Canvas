# ============================================================================
# Evan / AI 漫剧 0-1 生产工作台  环境变量示例
# ----------------------------------------------------------------------------
# 复制为 .env 后填入你自己的密钥。.env 已被 .gitignore 忽略，不会进入版本控制。
# 所有密钥只在服务端(server/)读取，绝不进入前端代码、工作流 JSON 或 Git。
# 没有任何密钥时，应用仍可启动、编辑画布、导入本地素材、并用本地素材完成 Remotion 渲染。
# 生图 / 生视频 / 配音 均调用线上官方 API，会产生费用（费用由密钥所属账号承担）。
# ============================================================================

# —— 提示词优化 ——
# DeepSeek V4 Flash（图片节点三种角色图提示词 + 视频节点提示词优化）
DEEPSEEK_API_KEY=
# 优化后端优先在“配置”弹窗的下拉里选（存到 library/config/optimizer.json）；下面的环境变量只是初始默认。
# 方法论指令与模型无关，切后端不改代码：
#   deepseek   → 用 DEEPSEEK_API_KEY 调 HTTP API（默认）
#   claude-cli → 子进程调用本机已登录的 Claude Code CLI，无需密钥（如不在 PATH 用 CLAUDE_CLI_PATH 指定绝对路径）
#   codex-cli  → 子进程调用本机 Codex CLI（codex exec），无需密钥；自动定位 ChatGPT.app 内置 codex，也可用 CODEX_CLI_PATH 覆盖
# PROMPT_OPTIMIZER_PROVIDER=deepseek
# 覆盖该后端的模型（可选）。claude-cli 可填 sonnet/opus/haiku；codex-cli 留空用其默认；deepseek 默认 deepseek-v4-flash。
# PROMPT_OPTIMIZER_MODEL=
# claude 可执行文件绝对路径（仅当 claude 不在服务端 PATH 时需要）
# CLAUDE_CLI_PATH=

# —— 图片生成 ——
# Google Gemini（图片、Veo 视频、剧本/分镜 LLM）
GEMINI_API_KEY=
# OpenAI（GPT Image 图片生成）
OPENAI_API_KEY=
# —— 视频生成 ——
# Seedance 2.0（火山方舟中国区）
ARK_API_KEY=
# 镜头角度控制（Modal 云端部署，见 docs/modal-camera-integration.md）
VITE_MODAL_CAMERA_ENDPOINT=

# —— 说明 ——
# Seedance 2.0 已接入官方任务接口；未配置对应密钥时会明确提示，不会伪造成功。
# ChatGPT Plus / Codex 自动生图（默认开启，不使用 OpenAI API Key）
CODEX_IMAGE_AUTOMATION=true
# 如 Codex 不在默认安装位置，可手动指定可执行文件
# CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex

# —— Google Flow / 即梦浏览器自动化（无需 API Key）——
# 桌面安装包已内置与 Playwright 匹配的 Chromium。
# 源码开发首次运行：npm run setup:browser-models
# 登录态只保存在本机专用 profile 中，不随项目或安装包分发。
# 以下仅用于开发诊断；正常用户无需配置。
# SESSIONHUB_CHROME_APP=/absolute/path/to/chromium
# SESSIONHUB_CHROME_PROFILE=
