{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "evan-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "PORT=3001 npm run dev"],
      "port": 5173
    },
    {
      "name": "vite-only",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npx vite --port 5199 --strictPort"],
      "port": 5199
    },
    {
      "name": "auth-worker",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd cloudflare && npx wrangler dev --port 8788"],
      "port": 8788
    },
    {
      "name": "repro-desktop-data",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "EVAN_DATA_DIR=\"$HOME/Library/Application Support/Evan AI Video Canvas/data\" PORT=3001 npm run dev"],
      "port": 5173
    }
  ]
}
