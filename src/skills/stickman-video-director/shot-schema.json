{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StickmanDirectorOutput",
  "type": "object",
  "required": ["version", "title", "sourceType", "model", "global", "shots"],
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "sourceType": { "enum": ["script", "reference_video"] },
    "model": {
      "type": "object",
      "required": ["provider", "modelId"],
      "properties": {
        "provider": { "enum": ["gemini", "codex", "deepseek"] },
        "modelId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "required": ["platform", "visualTheme", "aspectRatio", "width", "height", "totalDuration", "shotCount", "language", "pace", "audioEnabled"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "visualTheme": { "type": "string", "minLength": 1 },
        "aspectRatio": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 256 },
        "height": { "type": "integer", "minimum": 256 },
        "totalDuration": { "type": "number", "exclusiveMinimum": 0 },
        "shotCount": { "type": "integer", "minimum": 1 },
        "language": { "type": "string", "minLength": 1 },
        "pace": { "type": "string", "minLength": 1 },
        "audioEnabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "duration", "aspectRatio", "width", "height", "visual", "audio", "prompt", "generation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "sourceShotId": { "type": "string" },
          "sourceStartTime": { "type": "number", "minimum": 0 },
          "sourceEndTime": { "type": "number", "minimum": 0 },
          "sourceKeyframeUrl": { "type": "string" },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "aspectRatio": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 256 },
          "height": { "type": "integer", "minimum": 256 },
          "visual": { "type": "object" },
          "audio": { "type": "object" },
          "prompt": { "type": "string", "minLength": 1 },
          "generation": {
            "type": "object",
            "required": ["provider", "status"],
            "properties": {
              "provider": { "const": "flow" },
              "status": { "enum": ["pending", "queued", "generating", "completed", "failed", "cancelled"] },
              "retryCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
