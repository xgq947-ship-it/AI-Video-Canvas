# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.local-ai-cli/
codex-home/
# 仅忽略仓库根目录下的 runtime/（本地会话与任务状态）。
# 不能写成裸的 "runtime/"：那会匹配任意深度下名为 runtime 的目录，
# 连带把 server/runtime/（真正的源码目录，如 libraryPaths.js）也一并吞掉——
# 这正是 v0.2.15 发布时 CI 报 Cannot find module 的原因。
/runtime/
# 本机双击使用的开发控制器，由 npm run desktop:controller 生成。
/Evan 项目控制器.app/
# Playwright 调试时存的页面快照，一次性现场，不入库
.playwright-cli/
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

#env
.env

# Local review artifacts
.superpowers/


# data
library/

# Python virtual environment (local models)
venv/
__pycache__/
*.pyc

# Local AI models (too large to commit)
models/
.offload_cache/

# Agent workflows and shared utilities
.agent/
.shared/

# 浏览器自动化 Python 运行时（由 npm run setup:automation-runtime 生成）
server/python/.venv/
# 旧版曾下载 Chromium；保留忽略规则，防止本机遗留目录误提交
server/python/.browsers/
desktop-runtime/
release/
# 桌面图标由脚本生成；Windows 安装前置检查脚本需要入库
build/*
!build/installer.nsh
server/python/logs/
server/python/runtime/
server/python/output/
# 安全：登录态绝不入库
# browser-profile 是完整的 Chrome Profile（Default/Cookies、Login Data 等），
# 一旦入库就是把各平台登录凭据推到远端。正常位置在 Electron 的 userData 下，
# 但任何把 EVAN_BROWSER_PROFILE_DIR / SESSIONHUB_CHROME_PROFILE 设成相对路径的
# 调用都会在仓库根目录再造一份，必须无条件忽略。
browser-profile/
**/browser-profile/
server/python/sessionhub/data/
server/python/sessionhub/session/
**/cookies/
**/sessions/
