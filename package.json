{
  "name": "twitcanva",
  "productName": "Evan AI Video Canvas",
  "private": true,
  "version": "0.2.2",
  "main": "electron/main.js",
  "type": "module",
  "engines": {
    "//": "\u9700\u8981 Node 22+\uff1anpm test \u4f9d\u8d56 node --test \u81ea\u8eab\u7684\u901a\u914d\u7b26\u5c55\u5f00\uff08Node 21 \u8d77\u652f\u6301\uff09\u3002Windows \u7684 cmd \u4e0d\u5c55\u5f00 test/*.test.mjs\uff0c\u4f4e\u7248\u672c Node \u4f1a\u76f4\u63a5\u8dd1\u4e0d\u4e86\u6d4b\u8bd5\u3002",
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run desktop:dev",
    "setup": "node scripts/setup-project.mjs",
    "setup:ai-cli": "node scripts/setup-project.mjs --with-ai-cli",
    "setup:check": "node scripts/setup-project.mjs --check --skip-dependencies",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"vite --strictPort\"",
    "server": "node server/index.js",
    "mcp:claude": "node mcp/twitcanva-mcp.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "generate:test-assets": "node scripts/generate-test-assets.mjs",
    "render:e2e-test": "node scripts/proof-manifest-render.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:icons": "node scripts/generate-desktop-icons.mjs",
    "desktop:runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:verify": "node scripts/verify-desktop-runtime.mjs",
    "desktop:prepare": "npm run desktop:icons && npm run desktop:runtime && npm run desktop:verify",
    "desktop:pack": "npm run build && npm run desktop:prepare && electron-builder --dir",
    "desktop:dist": "npm run build && npm run desktop:prepare && electron-builder",
    "desktop:dist:mac": "npm run build && npm run desktop:prepare && electron-builder --mac --publish never",
    "desktop:dist:win": "npm run build && npm run desktop:prepare && electron-builder --win --x64 --publish never",
    "setup:automation-runtime": "node scripts/setup-browser-models.mjs",
    "setup:browser-models": "npm run setup:automation-runtime"
  },
  "dependencies": {
    "@google/genai": "^1.32.0",
    "@google/generative-ai": "^0.24.1",
    "@remotion/bundler": "^4.0.489",
    "@remotion/renderer": "^4.0.489",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "6.8.9",
    "express": "^5.2.1",
    "ffmpeg-ffprobe-static": "6.1.2-rc.1",
    "openai": "^6.14.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "remotion": "^4.0.489",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "face-api.js": "^0.22.2",
    "lucide-react": "^0.556.0",
    "three": "^0.182.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "com.evan.aivideocanvas",
    "productName": "Evan AI Video Canvas",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "remotion/**/*",
      "scripts/codex-image-queue.mjs",
      "integrations/skills/twitcanva-codex-images/**/*",
      "LICENSE",
      "NOTICE",
      "package.json",
      "!node_modules/ffmpeg-ffprobe-static{,/**/*}",
      "!server/python/.venv{,/**/*}",
      "!server/python/.browsers{,/**/*}",
      "!server/python/**/__pycache__{,/**/*}"
    ],
    "asarUnpack": [
      "server/python/**/*",
      "integrations/skills/twitcanva-codex-images/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop-runtime/current/evan-ops-cli",
        "to": "runtime/ops-cli"
      },
      {
        "from": "desktop-runtime/current/media-tools",
        "to": "media-tools"
      }
    ],
    "artifactName": "Evan-AI-Video-Canvas-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "xgq947-ship-it",
        "repo": "AI-Video-Canvas"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "shortcutName": "Evan AI Video Canvas",
      "uninstallDisplayName": "Evan AI Video Canvas",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    }
  }
}
