# ============================================================================
# TwitCanva / AI 漫剧 0-1 生产工作台  环境变量示例
# ----------------------------------------------------------------------------
# 复制为 .env 后填入你自己的密钥。.env 已被 .gitignore 忽略，不会进入版本控制。
# 所有密钥只在服务端(server/)读取，绝不进入前端代码、工作流 JSON 或 Git。
# 没有任何密钥时，应用仍可启动、编辑画布、导入本地素材、并用本地素材完成 Remotion 渲染。
# 生图 / 生视频 / 配音 均调用线上官方 API，会产生费用（费用由密钥所属账号承担）。
# ============================================================================

# —— 图片生成 ——
# Google Gemini（图片、Veo 视频、剧本/分镜 LLM）
GEMINI_API_KEY=
# OpenAI（GPT Image 图片生成）
OPENAI_API_KEY=

# —— 视频生成 ——
# 海螺 / MiniMax Hailuo（文生视频、图生视频、首尾帧）
HAILUO_API_KEY=
# 可灵 Kling 旧模型（AK/SK）
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# 可灵 Kling 3.x 新模型
KLING_API_KEY=
# Seedance 1.5 / 2.0（火山方舟中国区）
ARK_API_KEY=
# Fal.ai（Kling 2.6 Motion Control 等）
FAL_API_KEY=
# 镜头角度控制（Modal 云端部署，见 docs/modal-camera-integration.md）
VITE_MODAL_CAMERA_ENDPOINT=

# —— 配音（MiniMax T2A v2 文本转语音）——
# 若未单独设置 MINIMAX_API_KEY，服务端会回退使用 HAILUO_API_KEY 作为密钥。
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# —— 说明 ——
# Seedance 与 Kling 3 已接入官方任务接口；未配置对应密钥时会明确提示，不会伪造成功。
# ChatGPT Plus / Codex 自动生图（默认开启，不使用 OpenAI API Key）
CODEX_IMAGE_AUTOMATION=true
# 如 Codex 不在默认安装位置，可手动指定可执行文件
# CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
