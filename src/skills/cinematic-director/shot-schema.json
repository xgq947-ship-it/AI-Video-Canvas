{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CinematicDirectorOutput",
  "type": "object",
  "required": ["version", "title", "sourceType", "model", "global", "cast", "shots"],
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "sourceType": { "const": "script" },
    "model": {
      "type": "object",
      "required": ["provider", "modelId"],
      "properties": {
        "provider": { "enum": ["gemini", "deepseek", "codex"] },
        "modelId": { "type": "string", "minLength": 1 }
      }
    },
    "global": {
      "type": "object",
      "required": ["platform", "visualStyle", "aspectRatio", "width", "height", "totalDuration", "shotCount", "language", "pace", "videoModel", "audioEnabled"],
      "properties": {
        "platform": { "type": "string" },
        "visualStyle": { "type": "string" },
        "aspectRatio": { "enum": ["9:16", "16:9", "1:1", "4:5", "3:4"] },
        "width": { "type": "integer", "minimum": 256 },
        "height": { "type": "integer", "minimum": 256 },
        "totalDuration": { "type": "number", "exclusiveMinimum": 0 },
        "shotCount": { "type": "integer", "minimum": 1 },
        "language": { "type": "string" },
        "pace": { "type": "string" },
        "videoModel": { "type": "string", "minLength": 1 },
        "audioEnabled": { "type": "boolean" }
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "description", "referenceImages"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["protagonist", "supporting"] },
          "description": { "type": "string" },
          "referenceImages": { "type": "array" }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "duration", "scene", "action", "cast", "camera", "prompt", "generation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "scene": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "dialogue": { "type": ["object", "null"] },
          "cast": { "type": "array", "items": { "type": "string" } },
          "camera": { "type": "object" },
          "prompt": { "type": "string", "minLength": 1 },
          "generation": { "type": "object" }
        }
      }
    }
  }
}
